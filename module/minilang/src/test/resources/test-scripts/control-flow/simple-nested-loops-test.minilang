func testNestedLoops() -> boolean {
    let i: int = 0
    let j: int = 0
    let sum: int = 0

    while i < 3 {
        j = 0
        while j < 3 {
            sum = sum + 1
            j = j + 1
        }
        i = i + 1
    }

    if sum == 9 {
        return true
    }

    return false
}

let result: boolean = testNestedLoops()
