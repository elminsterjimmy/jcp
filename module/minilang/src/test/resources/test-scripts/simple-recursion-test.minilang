func factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

func testRecursion() -> boolean {
    if factorial(5) != 120 {
        return false
    }
    if factorial(10) != 3628800 {
        return false
    }
    return true
}

let result: boolean = testRecursion()
