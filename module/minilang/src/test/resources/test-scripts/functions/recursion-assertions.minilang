# Test recursion with assertions
func factorial(n: int) -> int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

Assertions.assertTrue(factorial(0) == 1)
Assertions.assertTrue(factorial(1) == 1)
Assertions.assertTrue(factorial(5) == 120)
Assertions.assertTrue(factorial(10) == 3628800)
